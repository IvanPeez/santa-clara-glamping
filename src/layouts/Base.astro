---
import { getImage } from 'astro:assets';
import '../styles/global.css';
import { site, hero } from '../data/site';

// Imagen para compartir en redes: recorte 1200 × 630
const og = await getImage({ src: hero.image, width: 1200, height: 630, fit: 'cover', format: 'jpg' });
// og:image debe ser absoluta: configura `site` en astro.config.mjs cuando haya dominio
const ogImage = Astro.site ? new URL(og.src, Astro.site).href : og.src;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LodgingBusiness',
  name: site.name,
  description: site.description,
  telephone: `+${site.whatsapp}`,
  image: ogImage,
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Vía La Elvira, km 18',
    addressLocality: 'Cali',
    addressRegion: 'Valle del Cauca',
    addressCountry: 'CO',
  },
  checkinTime: '15:00',
  checkoutTime: '12:00',
  sameAs: [site.instagram.url, site.tiktok.url],
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{site.title}</title>
    <meta name="description" content={site.description} />
    <meta name="theme-color" content="#1C2620" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.svg`} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:title" content={site.title} />
    <meta property="og:description" content={site.description} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <slot />
    <script>
      import '../scripts/main.ts';
    </script>
  </body>
</html>
