---
import ArtPicture from './ArtPicture.astro';
import { entorno } from '../data/site';
const count = entorno.items.length;
---

<section
  class="entorno"
  id="entorno"
  data-header-theme="light"
  data-entorno
  style={`--count: ${count}`}
>
  <div class="entorno__sticky">
    <div class="entorno__intro container" data-entorno-intro>
      <h2 class="heading-l" set:html={entorno.intro.title} />
    </div>

    {
      entorno.items.map((item) => (
        <div class="entorno__item" data-entorno-item>
          <figure class="entorno__media media" data-entorno-img>
            <ArtPicture src={item.image} mobile={item.imageMobile} alt={item.alt} />
          </figure>
          <div class="entorno__text" data-entorno-text>
            <h3 class="heading-m">{item.title}</h3>
            <p class="body-text">{item.text}</p>
          </div>
        </div>
      ))
    }

    <div class="entorno__progress" aria-hidden="true">
      {entorno.items.map(() => <span><span data-entorno-bar /></span>)}
    </div>
  </div>
</section>

<style>
  /* Modo por defecto (sin JS o con reduced-motion): bloques uno debajo del otro.
     main.ts agrega .is-sticky para el timeline del paso 5. */
  .entorno {
    background: var(--bosque);
    color: var(--niebla);
  }

  .entorno__intro {
    display: grid;
    gap: 22px;
    padding-block: var(--module);
    max-width: 900px;
  }

  .entorno__item {
    position: relative;
    height: 100svh;
    min-height: 560px;
  }

  .entorno__media {
    position: absolute;
    inset: 0;
    background: var(--musgo);
  }

  .entorno__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgb(14 21 16 / 0.7), transparent 55%);
  }

  .entorno__text {
    position: absolute;
    right: var(--gutter);
    bottom: calc(var(--gutter) + 24px);
    left: var(--gutter);
    display: grid;
    gap: 14px;
    max-width: 420px;
  }

  .entorno__progress {
    display: none;
  }

  @media (min-width: 768px) {
    .entorno__text {
      left: auto;
    }
  }

  /* Modo sticky */
  .entorno.is-sticky {
    height: calc((var(--count) + 1) * 100vh);
  }

  .entorno.is-sticky .entorno__sticky {
    position: sticky;
    top: 0;
    height: 100vh;
    overflow: hidden;
  }

  .entorno.is-sticky .entorno__intro {
    position: absolute;
    inset: 0;
    align-content: center;
    z-index: 2;
  }

  .entorno.is-sticky .entorno__item {
    position: absolute;
    inset: 0;
    height: auto;
    min-height: 0;
  }

  .entorno.is-sticky .entorno__progress {
    position: absolute;
    left: var(--gutter);
    top: calc(var(--header-h) + 12px);
    z-index: 3;
    display: flex;
    gap: 8px;
  }

  .entorno.is-sticky .entorno__progress > span {
    width: 36px;
    height: 1px;
    background: rgb(236 238 232 / 0.3);
    overflow: hidden;
  }

  @media (min-width: 768px) {
    .entorno.is-sticky .entorno__progress {
      top: auto;
      bottom: calc(var(--gutter) + 24px);
    }
  }

  .entorno.is-sticky [data-entorno-bar] {
    display: block;
    height: 100%;
    background: var(--niebla);
    transform: scaleX(0);
    transform-origin: left;
  }
</style>
