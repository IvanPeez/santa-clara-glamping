---
// <picture> con dirección de arte: la foto `mobile` (vertical) se usa por debajo de 768 px
// y `src` (horizontal) desde ahí. Cada una sale en AVIF y WebP en varios anchos.
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import { photo } from '../data/images';

interface Props {
  src: ImageMetadata;
  mobile?: ImageMetadata;
  alt: string;
  sizes?: string;
  [attr: string]: unknown;
}

const { src, mobile, alt, sizes = '100vw', ...attrs } = Astro.props;
const mq = '(max-width: 767px)';
const widthsFor = (img: ImageMetadata) => photo.widths.filter((w) => w <= img.width);

const sources: { media?: string; type: string; srcset: string }[] = [];
for (const [img, media] of [
  ...(mobile ? [[mobile, mq] as const] : []),
  [src, undefined] as const,
]) {
  for (const format of photo.formats) {
    const out = await getImage({ src: img, format, widths: widthsFor(img) });
    sources.push({ media, type: `image/${format}`, srcset: out.srcSet.attribute });
  }
}

const fallback = await getImage({ src, format: 'jpg', width: Math.min(1920, src.width) });
---

<picture>
  {sources.map((s) => <source media={s.media} type={s.type} srcset={s.srcset} sizes={sizes} />)}
  <img
    src={fallback.src}
    alt={alt}
    width={src.width}
    height={src.height}
    loading={photo.loading}
    decoding={photo.decoding}
    {...attrs}
  />
</picture>
