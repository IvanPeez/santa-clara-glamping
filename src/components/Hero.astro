---
import { Picture } from 'astro:assets';
import { hero } from '../data/site';
---

<section class="hero" id="inicio" data-header-theme="light" data-hero>
  <div class="hero__media media" data-hero-media>
    <!-- El primer fotograma va como imagen optimizada debajo del video: se pinta primero
         y queda a la vista si el video no carga o la persona prefiere menos movimiento -->
    <Picture
      src={hero.image}
      alt=""
      formats={['avif', 'webp']}
      widths={[640, 960, 1280, 1920]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class="hero__poster"
    />
    <!-- Sin autoplay ni precarga: main.ts lo arranca cuando la página ya cargó -->
    <video muted loop playsinline preload="none" aria-label={hero.alt} data-hero-img>
      <source src={hero.video720} type="video/mp4" media="(max-width: 900px)" />
      <source src={hero.video} type="video/mp4" />
    </video>
  </div>
  <div class="hero__shade" aria-hidden="true"></div>

  <div class="hero__content container" data-hero-content>
    <!-- Visible desde el primer pintado: es el primer texto que cuenta para el LCP -->
    <p class="label hero__label">{hero.label}</p>
    <h1 class="heading-xl hero__title">
      {
        hero.title.map((part) => {
          const words = part.text.split(' ');
          return (
            <span class="hero__line">
              {words.map((w) => (
                <span class="hero__word-mask">
                  {part.em ? (
                    <em class="hero__word" data-hero-word>{w}</em>
                  ) : (
                    <span class="hero__word" data-hero-word>{w}</span>
                  )}
                </span>
              ))}
            </span>
          );
        })
      }
    </h1>
  </div>

  <a class="hero__scroll label" href="#experiencia" data-hero-fade>
    {hero.scroll}
    <span class="hero__scroll-line" aria-hidden="true"></span>
  </a>
</section>

<style>
  .hero {
    position: relative;
    height: 100svh;
    min-height: 560px;
    overflow: hidden;
    color: var(--niebla);
    background: var(--bosque);
  }

  .hero__media {
    position: absolute;
    inset: 0;
    background: var(--bosque);
  }

  .hero__media video,
  .hero__media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to bottom, rgb(14 21 16 / 0.55), transparent 28%),
      linear-gradient(to top, rgb(14 21 16 / 0.6), transparent 45%),
      rgb(14 21 16 / 0.12);
  }

  .hero__content {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 22px;
    height: 100%;
    max-width: 1100px;
  }

  .hero__title {
    display: flex;
    flex-direction: column;
  }

  .hero__line {
    display: block;
  }

  /* Teléfonos angostos: que "Hospedaje mágico" siga en una línea */
  @media (max-width: 379px) {
    .hero__title {
      font-size: 2.3rem;
    }
  }

  .hero__word-mask {
    display: inline-block;
    overflow: hidden;
    vertical-align: top;
    padding-bottom: 0.08em;
    margin-right: 0.24em;
  }

  .hero__word-mask:last-child {
    margin-right: 0;
  }

  .hero__word {
    display: inline-block;
  }

  .hero__scroll {
    position: absolute;
    left: 50%;
    bottom: 28px;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
  }

  .hero__scroll-line {
    width: 1px;
    height: 48px;
    background: currentColor;
    opacity: 0.6;
    transform-origin: top;
    animation: scroll-line 2.4s var(--ease) infinite;
  }

  @keyframes scroll-line {
    0% {
      transform: scaleY(0);
      transform-origin: top;
    }
    45% {
      transform: scaleY(1);
      transform-origin: top;
    }
    55% {
      transform: scaleY(1);
      transform-origin: bottom;
    }
    100% {
      transform: scaleY(0);
      transform-origin: bottom;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__scroll-line {
      animation: none;
    }
  }
</style>
